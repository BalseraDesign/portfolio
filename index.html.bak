	<section id="inicio">
		<h2 class="typing" data-translate="titulo-principal">Hola, soy Daniel</h2>
		<p data-translate="subtitulo">Diseñador web & programador.</p>
		<p data-translate="descripcion-inicio">Combino diseño intuitivo con código limpio para crear experiencias web
			funcionales y visualmente impactantes.</p>
	</section>

	<section id="sobre-mi">
		<h2 data-translate="sobre-mi-titulo">Sobre mí</h2>
		<p data-translate="sobre-mi-p1">CRM/ERP Consultant & Developer con experiencia en Odoo y Dolibarr. Actualmente trabajo como Technical Lead en Win Innovación, liderando equipos técnicos y desarrollando soluciones ERP/CRM para clientes. Busco nuevas oportunidades y estoy disponible para relocation a Irlanda.</p>

		<h3 data-translate="core-skills-titulo">Competencias principales</h3>
		<ul data-translate="core-skills-list">
			<li>ERPs & CRMs (Dolibarr, Odoo)</li>
			<li>Desarrollo web: PHP, JavaScript, HTML5/CSS3</li>
			<li>APIs, AJAX, Python, SQL</li>
			<li>Soporte técnico y comunicación con clientes</li>
			<li>Control de versiones: Git / GitHub</li>
		</ul>
	</section>

	<!-- Sección "Proyectos en progreso" eliminada según CV; los proyectos relevantes pasan a la sección principal -->
			<div class="proyecto">
				<img src="./imgs/Clima-Sites.png" alt="Proyecto 3" style="width: 80%; height: auto; cursor: pointer;"
					class="proyecto-img">
				<h3>Clima-Sites</h3>
				<p data-translate="proyecto-clima">Clima-Sites es una herramienta web interactiva...</p>
				<div class="iconosTecnologias">
					<iconify-icon icon="simple-icons:javascript"></iconify-icon>
					<iconify-icon icon="simple-icons:css"></iconify-icon>
					<iconify-icon icon="simple-icons:html5"></iconify-icon>
					<section id="proyectos">
						<h2 data-translate="proyectos-titulo">Proyectos Profesionales</h2>

						<h3 class="categoriaProyecto" data-translate="paginas-web">Páginas web</h3>
						<article class="proyectos-grid">
							<div class="proyecto">
								<img src="./imgs/mamasmagicas.png" alt="Web Mamás Mágicas" style="width: 80%; height: auto; cursor: pointer;" class="proyecto-img">
								<h3>Web Mamás Mágicas</h3>
								<p data-translate="proyecto-mamas">Web corporativa para Escuela Para Mamás Mágicas. Implementación con WordPress y Avada, diseño responsive y funcionalidades de reservas y contacto.</p>
								<div class="iconosTecnologias">
									<iconify-icon icon="simple-icons:wordpress"></iconify-icon>
									<iconify-icon icon="simple-icons:css"></iconify-icon>
									<iconify-icon icon="simple-icons:html5"></iconify-icon>
								</div>
								<a href="https://escuelaparamamasmagicas.com/" target="_blank" data-translate="ver-proyecto">Ver proyecto</a>
							</div>
						</article>

						<h3 class="categoriaProyecto" style="margin-top:20px" data-translate="apps-web">Apps Web / ERP & CRM</h3>
						<article class="proyectos-grid">
							<div class="proyecto">
								<img src="./imgs/erp-solutions.png" alt="ERP/CRM Solutions" style="width: 80%; height: auto; cursor: pointer;" class="proyecto-img">
								<h3>ERP/CRM Solutions (Dolibarr & Odoo)</h3>
								<p data-translate="proyecto-erp">Desarrollo y personalización de ERPs y CRMs para clientes usando Dolibarr y Odoo. Implementación de módulos, adaptación de procesos, integración de APIs y soporte técnico durante distintas fases del proyecto.</p>
								<div class="iconosTecnologias">
									<iconify-icon icon="simple-icons:odoo"></iconify-icon>
									<iconify-icon icon="simple-icons:odoo"></iconify-icon>
									<iconify-icon icon="simple-icons:open-source"></iconify-icon>
								</div>
								<a href="#" target="_blank" data-translate="ver-proyecto">Ver proyecto</a>
							</div>

							<div class="proyecto">
								<img src="./imgs/business-analytics.png" alt="Business Analytics Dolibarr" style="width: 80%; height: auto; cursor: pointer;" class="proyecto-img">
								<h3>Módulo Business Analytics (Dolibarr)</h3>
								<p data-translate="proyecto-businessanalytics">Módulo desarrollado para Dolibarr con PHP, HTML, CSS, JavaScript y SQL. Permite registrar y visualizar clientes nuevos, número de productos, facturas pendientes y ventas totales mediante gráficos interactivos.</p>
								<div class="iconosTecnologias">
									<iconify-icon icon="vscode-icons:file-type-php3"></iconify-icon>
									<iconify-icon icon="vscode-icons:file-type-js-official"></iconify-icon>
									<iconify-icon icon="mdi:chart-line"></iconify-icon>
								</div>
								<a href="#" target="_blank" data-translate="ver-proyecto">Ver proyecto</a>
							</div>
						</article>

					</section>
